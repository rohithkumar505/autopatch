{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "outputDirectory": "public",
  "installCommand": "pip install -r requirements.txt && cd frontend && npm ci",
  "buildCommand": "bash scripts/vercel-build.sh",
  "functions": {
    "index.py": {
      "maxDuration": 60,
      "memory": 2048
    }
  }
}